{
  "id": "apple",
  "name": "Apple Keynote",
  "family": "Clean & friendly",
  "defaultMode": "light",
  "description": "Keynote-like: huge headlines, lots of whitespace, slow and elegant motion.",
  "bestFor": "Executive audiences, launches, one big idea per scene.",
  "inspiredBy": "Apple keynote slides",
  "colors": {
    "background": "#FFFFFF",
    "surface": "#F5F5F7",
    "foreground": "#1D1D1F",
    "muted": "#F5F5F7",
    "mutedForeground": "#6E6E73",
    "border": "#D2D2D7",
    "primary": "#0071E3",
    "primaryForeground": "#FFFFFF",
    "accent": "#0071E3",
    "success": "#248A3D",
    "warning": "#B25000",
    "danger": "#D70015"
  },
  "darkColors": {
    "background": "#000000",
    "surface": "#1D1D1F",
    "foreground": "#F5F5F7",
    "muted": "#1D1D1F",
    "mutedForeground": "#A1A1A6",
    "border": "#424245",
    "primary": "#2997FF",
    "primaryForeground": "#000000",
    "accent": "#2997FF"
  },
  "fonts": {
    "heading": "Inter",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "packages": ["@fontsource/inter", "@fontsource/jetbrains-mono"]
  },
  "typography": {
    "headingWeight": 700,
    "headingTracking": "-0.04em",
    "scale": 1.15
  },
  "radius": "20px",
  "borderWidth": "0px",
  "shadow": "0 2px 12px rgba(0,0,0,0.06)",
  "effects": ["keynote"],
  "motion": {
    "durationMs": 1000,
    "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)",
    "entrance": "fade",
    "stagger": 0.3
  },
  "mermaid": {
    "look": "classic",
    "themeVariables": {}
  },
  "signature": ["Very large bold headlines with tight tracking", "Generous whitespace, centred composition", "Single blue accent", "Slow cross-fades"],
  "avoid": ["Busy layouts", "Visible borders everywhere", "More than one accent colour"]
}

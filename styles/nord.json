    "border": "#4C566A",
    "primary": "#88C0D0",
    "primaryForeground": "#2E3440",
    "accent": "#81A1C1",
    "success": "#A3BE8C",
    "warning": "#EBCB8B",
    "danger": "#BF616A"
  },
  "lightColors": {
    "background": "#ECEFF4",
    "surface": "#E5E9F0",
    "foreground": "#2E3440",
    "muted": "#D8DEE9",
    "mutedForeground": "#4C566A",
    "border": "#D8DEE9",
    "primary": "#5E81AC",
    "primaryForeground": "#ECEFF4",
    "accent": "#5E81AC"

{
  "id": "neo-brutalism",
  "name": "Neo-brutalism",
  "family": "Bold & creative",
  "defaultMode": "light",
  "description": "Thick black borders, hard offset shadows, flat bright fills and snappy motion.",
  "bestFor": "Startups, creative products, younger audiences, anything that should feel bold.",
  "colors": {
    "background": "#FFFDF5",
    "surface": "#FFFFFF",
    "foreground": "#000000",
    "muted": "#F3EFDF",
    "mutedForeground": "#3A3A3A",
    "border": "#000000",
    "primary": "#FFDE59",
    "primaryForeground": "#000000",
    "accent": "#FF6B6B",
    "success": "#A3E635",
    "warning": "#FFDE59",
    "danger": "#FF6B6B"
  },
  "palette": ["#FFDE59", "#FF6B6B", "#4ECDC4", "#A3E635", "#C4B5FD"],
  "fonts": {
    "heading": "Archivo Black",
    "body": "Space Grotesk",
    "mono": "JetBrains Mono",
    "packages": ["@fontsource/archivo-black", "@fontsource/space-grotesk", "@fontsource/jetbrains-mono"]
  },
  "typography": {
    "headingWeight": 400,
    "bodyWeight": 500,
    "headingTracking": "-0.01em"
  },
  "radius": "8px",
  "borderWidth": "3px",
  "shadow": "6px 6px 0 #000000",
  "effects": ["hard-shadow", "pastel-cards"],
  "motion": {
    "durationMs": 280,
    "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "entrance": "pop",
    "stagger": 0.08
  },
  "mermaid": {
    "look": "classic",
    "themeVariables": {
      "primaryColor": "#FFDE59",
      "primaryBorderColor": "#000000",
      "lineColor": "#000000",
      "secondaryColor": "#4ECDC4",
      "tertiaryColor": "#C4B5FD"
    },
    "themeCSS": ".node rect, .node polygon, .node circle, .node path { stroke-width: 3px !important; } .flowchart-link { stroke-width: 3px !important; }"
  },
  "signature": ["3px black borders on everything", "Hard 6px offset shadows", "Flat yellow, coral, teal, lime and lilac fills", "Archivo Black headlines", "Springy pop-in motion"],
  "avoid": ["Soft blurred shadows", "Gradients", "Thin grey hairlines"]
}

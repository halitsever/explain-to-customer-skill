{
  "id": "catppuccin",
  "name": "Catppuccin",
  "family": "Extended",
  "defaultMode": "dark",
  "description": "Soft pastels: Mocha (dark) by default, Latte (light) as the light mode.",
  "bestFor": "Friendly developer audiences, side projects, cosy product updates.",
  "inspiredBy": "Catppuccin Mocha and Latte",
  "colors": {
    "background": "#1E1E2E",
    "surface": "#313244",
    "foreground": "#CDD6F4",
    "muted": "#45475A",
    "mutedForeground": "#A6ADC8",
    "border": "#45475A",
    "primary": "#CBA6F7",
    "primaryForeground": "#1E1E2E",
    "accent": "#89B4FA",
    "success": "#A6E3A1",
    "warning": "#FAB387",
    "danger": "#F38BA8"
  },
  "lightColors": {
    "background": "#EFF1F5",
    "surface": "#E6E9EF",
    "foreground": "#4C4F69",
    "muted": "#CCD0DA",
    "mutedForeground": "#5C5F77",
    "border": "#BCC0CC",
    "primary": "#8839EF",
    "primaryForeground": "#EFF1F5",
    "accent": "#1E66F5",
    "success": "#40A02B",
    "warning": "#FE640B",
    "danger": "#D20F39"
  },
  "palette": ["#CBA6F7", "#89B4FA", "#A6E3A1", "#FAB387", "#F5C2E7"],
  "fonts": {
    "heading": "Nunito",
    "body": "Nunito",
    "mono": "JetBrains Mono",
    "packages": ["@fontsource/nunito", "@fontsource/jetbrains-mono"]
  },
  "typography": {
    "headingWeight": 800,
    "bodyWeight": 500,
    "headingTracking": "-0.01em"
  },
  "radius": "14px",
  "borderWidth": "1px",
  "shadow": "0 10px 30px rgba(17,17,27,0.35)",
  "effects": ["pastel-cards"],
  "motion": {
    "durationMs": 600,
    "easing": "cubic-bezier(0.34, 1.3, 0.64, 1)",
    "entrance": "pop"
  },
  "mermaid": {
    "look": "classic",
    "themeVariables": {}
  },
  "signature": ["Mocha base #1E1E2E with lavender text", "Mauve, blue, green, peach and pink pastels", "Rounded friendly Nunito", "Gentle springy motion"],
  "avoid": ["Harsh saturated colours", "Sharp square corners"]
}

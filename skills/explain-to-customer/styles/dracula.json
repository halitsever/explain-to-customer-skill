{
  "id": "dracula",
  "name": "Dracula",
  "family": "Extended",
  "defaultMode": "dark",
  "description": "The classic dark developer theme: purple, pink, green and cyan on charcoal.",
  "bestFor": "Developer audiences, code-related features, night-mode products.",
  "inspiredBy": "Dracula theme",
  "colors": {
    "background": "#282A36",
    "surface": "#343746",
    "foreground": "#F8F8F2",
    "muted": "#44475A",
    "mutedForeground": "#BFC2D9",
    "border": "#6272A4",
    "primary": "#BD93F9",
    "primaryForeground": "#282A36",
    "accent": "#FF79C6",
    "success": "#50FA7B",
    "warning": "#F1FA8C",
    "danger": "#FF5555"
  },
  "palette": ["#BD93F9", "#FF79C6", "#50FA7B", "#8BE9FD", "#FFB86C"],
  "fonts": {
    "heading": "JetBrains Mono",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "packages": ["@fontsource/jetbrains-mono", "@fontsource/inter"]
  },
  "typography": {
    "headingWeight": 800,
    "headingTracking": "-0.02em",
    "scale": 0.95
  },
  "radius": "10px",
  "borderWidth": "1px",
  "shadow": "0 12px 32px rgba(0,0,0,0.35)",
  "effects": ["pastel-cards"],
  "motion": {
    "durationMs": 550,
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "entrance": "fade-up"
  },
  "mermaid": {
    "look": "classic",
    "themeVariables": {}
  },
  "signature": ["Charcoal #282A36 background", "Purple #BD93F9 primary, pink #FF79C6 accent", "Green and cyan highlights", "Monospace headings"],
  "avoid": ["Light backgrounds", "Muted corporate palettes"]
}
